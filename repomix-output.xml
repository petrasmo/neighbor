    switchAuthTab(initialTab);
    clearAuthErrors();
    modal.classList.remove('hidden');

    const panel = document.getElementById('auth-sheet-panel');
    setTimeout(() => {
        if (panel) panel.classList.remove('translate-y-full');
    }, 15);
