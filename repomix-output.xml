                            <div>
                                <div class="text-xs text-slate-300 uppercase font-extrabold tracking-wider">
                                    ${state.includeTransport ? 'PELNAS Į KIŠENĘ (SU TRANSPORTO ĮVERTINIMU)' : 'GRYNASIS IŠMOKĖJIMAS'}
                                </div>
