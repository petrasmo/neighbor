        statusTitle = "🔴 ŠIUO METU PURKŠTI DRAUDŽIAMA";
        shortReason = evaluation.reasons.join(', ');
        borderColor = "border-red-500/40";
        bgColor = "bg-red-500/10";
    } else if (evaluation.status === 'yellow') {
        statusTitle = "🟡 SĄLYGOS RIZIKINGOS";
