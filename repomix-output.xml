                            <strong class="text-white font-bold">${item.prices?.peas ? item.prices.peas + ' €' : '-'}</strong>
                        </div>
                    </div>
                    
                    <div class="border-t border-tractorBorder/60 pt-2 flex justify-between text-xs font-semibold text-amber-300">
