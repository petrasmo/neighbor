// js/matif.js
import { db } from '../core/firebase.js';

let matifMarketData = null;
let activeCropId = 'rapeseed';
let activeRange = '6M';
let hoveredPoint = null;
let unsubscribeMatif = null;

export function renderMatifSection(container) {
    if (!container) return;

